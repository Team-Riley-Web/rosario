---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProductsSection, { SHOP_PRODUCTS_PER_PAGE } from '../components/ProductsSection.astro';
import { getAllProducts, sortShopProductsForDisplay } from '../lib/shopify';
import wornImage from '../assets/images/ms-usa-1.png';
import wornImageSecondary from '../assets/images/ms-usa-3.png';

const allProducts = await getAllProducts();
const products = sortShopProductsForDisplay(
  allProducts.map((product, bestSellingRank) => ({ ...product, bestSellingRank }))
);
const totalPages = Math.max(1, Math.ceil(products.length / SHOP_PRODUCTS_PER_PAGE));
---

<Layout
  title="Shop One-of-a-Kind Murano Glass"
  description="Browse one-of-a-kind Murano glass jewelry, restored vintage Millefiori, freshwater pearls, and maker beads."
>
  <Nav />
  <main>
    <ProductsSection
      variant="complete"
      products={products}
      pagination={{
        currentPage: 1,
        totalPages,
        totalProducts: products.length,
      }}
      headerImage={{
        src: wornImage.src,
        alt: 'A woman wearing a Rosario Leonardi Murano glass necklace',
      }}
      headerImageSecondary={{
        src: wornImageSecondary.src,
        alt: 'A woman wearing a blue Rosario Leonardi Murano glass necklace',
      }}
    />
  </main>
</Layout>
